---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Projects and publications by Ryan Slocum.",
	title: "Projects",
};

const allItems = await getCollection("project");

const sorted = allItems.sort((a, b) => {
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return b.data.year - a.data.year;
});

const typeBadge: Record<string, string> = {
	project: "Project",
	paper: "Paper",
	poster: "Poster",
	thesis: "Thesis",
	preprint: "Preprint",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Projects</h1>
	<ul class="space-y-12" role="list">
		{
			sorted.map((item) => (
				<li class="border-b border-gray-200 pb-12 last:border-0 dark:border-gray-700">
					<div class="sm:flex sm:gap-6">
						{item.data.image && (
							<div class="mb-4 sm:mb-0 sm:w-48 sm:shrink-0">
								<img
									alt={item.data.title}
									class="w-full rounded object-cover sm:h-32"
									loading="lazy"
									src={item.data.image}
								/>
							</div>
						)}
						<div class="flex-1">
							<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
								<a class="cactus-link font-semibold text-base" href={`/projects/${item.id}/`}>{item.data.title}</a>
								<span class="text-accent bg-accent/10 rounded px-1.5 py-0.5 text-xs font-mono">
									{typeBadge[item.data.type]}
								</span>
								<span class="text-muted text-xs">{item.data.year}</span>
							</div>
							{item.data.venue && (
								<p class="text-muted text-xs mb-2 italic">{item.data.venue}</p>
							)}
							<p class="text-sm mb-3">{item.data.description}</p>
							{item.data.links && item.data.links.length > 0 && (
								<div class="flex flex-wrap gap-x-3 gap-y-1">
									{item.data.links.map((l) => (
										<a
											class="cactus-link text-xs font-mono"
											href={l.url}
											rel="noreferrer"
											target="_blank"
										>
											[{l.label}]
										</a>
									))}
								</div>
							)}
						</div>
					</div>
				</li>
			))
		}
	</ul>
</PageLayout>
